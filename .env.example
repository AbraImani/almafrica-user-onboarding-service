# Application
ALMAFRICA_APP_NAME="Almafrica User Onboarding Service"
ALMAFRICA_APP_VERSION="0.1.0"
ALMAFRICA_ENVIRONMENT="local"
ALMAFRICA_DEBUG="false"
ALMAFRICA_API_V1_PREFIX="/api/v1"

# PostgreSQL
# Docker Compose overrides the API container host with the service name `postgres`.
ALMAFRICA_DATABASE_HOST="localhost"
ALMAFRICA_DATABASE_PORT="5432"
ALMAFRICA_DATABASE_NAME="almafrica"
ALMAFRICA_DATABASE_USER="almafrica"
ALMAFRICA_DATABASE_PASSWORD="almafrica"
ALMAFRICA_DATABASE_CONNECT_TIMEOUT_SECONDS="3"

# Local SMTP / Mailpit
# Docker Compose overrides the API container host with the service name `mailpit`.
ALMAFRICA_SMTP_HOST="localhost"
ALMAFRICA_SMTP_PORT="1025"
ALMAFRICA_SMTP_FROM_EMAIL="no-reply@example.com"
ALMAFRICA_SMTP_FROM_NAME="Almafrica"
ALMAFRICA_SMTP_TIMEOUT_SECONDS="10"
ALMAFRICA_EMAIL_VERIFICATION_URL="http://localhost:8000/api/v1/auth/verify-email"

# JWT access tokens (replace with at least 32 cryptographically random characters)
ALMAFRICA_JWT_SECRET="replace-with-a-long-random-secret-value"
ALMAFRICA_JWT_ALGORITHM="HS256"
ALMAFRICA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES="15"
ALMAFRICA_REFRESH_TOKEN_EXPIRE_DAYS="7"
ALMAFRICA_LOGIN_RATE_LIMIT_ATTEMPTS="5"
ALMAFRICA_LOGIN_RATE_LIMIT_WINDOW_SECONDS="60"

# Local private object storage / MinIO
# Docker Compose overrides the API endpoint with the service name `minio`.
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="profile-images"

# Administrator seed (replace the password before running the seed command)
ADMIN_FULL_NAME="Almafrica Administrator"
ADMIN_EMAIL="admin@almafrica.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
